{
  "name": "tais",
  "productName": "TAIS",
  "version": "0.1.0",
  "description": "Исполнительные схемы строительных лесов",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "set TAIS_DEV_URL=http://127.0.0.1:5173&& electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.tais.app",
    "electronVersion": "44.8.0",
    "electronDist": "node_modules/electron/dist",
    "productName": "TAIS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../Backend/dist/tais-backend",
        "to": "backend"
      },
      {
        "from": "../Library",
        "to": "library"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TAIS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
